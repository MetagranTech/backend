PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/homestepin
JWT_ACCESS_SECRET=replace-with-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d
PAYMENT_WEBHOOK_SECRET=replace-with-payment-webhook-secret
ADMIN_BOOTSTRAP_EMAIL=admin@homestepin.local
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe_Admin_1
PUBLIC_BASE_URL=http://127.0.0.1:4000
# Comma-separated browser origins. Required in production, for example:
# CORS_ALLOWED_ORIGINS=https://admin.homestepin.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Required in production. Never expose RAZORPAY_KEY_SECRET to clients.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Gmail password-reset OTP delivery. Create Google OAuth credentials with the
# gmail.send scope and store these only in your production secret manager.
GMAIL_SENDER_EMAIL=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
UPLOAD_MAX_MB=8
ENTER_HOME_MAX_METERS=180

# Mappls (MapmyIndia) Server-Side REST API Credentials
# Obtain from Mappls Developer Console (https://apis.mappls.com/console/ -> Credentials / API Keys)
#
# Option A (Standard OAuth 2.0 Server Credentials - Recommended):
MAPPLS_CLIENT_ID=
MAPPLS_CLIENT_SECRET=
#
# Option B (Static REST API Key / Token):
MAPPLS_API_KEY=

# =========================================
# HOMESTEPIN EMAIL CONFIGURATION
# =========================================

# Primary email provider: api or smtp
EMAIL_PROVIDER=api

# Optional fallback: none, api or smtp
EMAIL_FALLBACK_PROVIDER=none

# =========================================
# BREVO EMAIL API
# =========================================

BREVO_API_KEY=your_brevo_api_key

# =========================================
# BREVO SMTP
# =========================================

BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_SECURE=false

BREVO_SMTP_LOGIN=your_brevo_smtp_login
BREVO_SMTP_KEY=your_brevo_smtp_key

# =========================================
# EMAIL SENDER
# =========================================

EMAIL_FROM=your_verified_sender_email@example.com
EMAIL_FROM_NAME=HomeStepIn
OTP_SECRET=your_long_random_secret_at_least_32_characters

# =========================================
# RESEND EMAIL DELIVERY (Customer & Worker OTP)
# =========================================
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=HomeStepIn <onboarding@resend.dev>

# =========================================
# ONESIGNAL PUSH NOTIFICATIONS
# =========================================
ONESIGNAL_APP_ID=your_onesignal_app_id
ONESIGNAL_REST_API_KEY=your_onesignal_rest_api_key

# WebRTC Audio Calling — TURN / STUN Configuration
# In development, Google public STUN servers are used by default.
# For production symmetric NAT / firewall traversal, configure your Coturn or cloud TURN relay:
# TURN_SERVER_URLS=turn:turn.homestepin.com:3478?transport=udp,turn:turn.homestepin.com:3478?transport=tcp
# For ephemeral time-limited HMAC credentials (Coturn / REST API auth):
# TURN_SECRET=your_coturn_shared_secret
# Alternatively, for static TURN credentials:
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Cloudinary Storage — Service Catalog & Category Images Only
# Do NOT use for user profile images, worker avatars, chat media, or documents.
# Option A: Individual credentials (Recommended):
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Option B: Or provide the single Cloudinary connection URL:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Initial Permanent Super Admin Provisioning
INITIAL_SUPERADMIN_1_EMAIL=fazil@homestepin.com
INITIAL_SUPERADMIN_1_PASSWORD=homestepin@fazil
INITIAL_SUPERADMIN_2_EMAIL=vinothan@homestepin.com
INITIAL_SUPERADMIN_2_PASSWORD=homestepin@vinothan

NODE_ENV=development
